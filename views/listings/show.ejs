<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row">
            <div class="col-8 ">
                <div class="mb-3 col-8 offset-6 listing-card">
                    <h4>
                        <b>Title</b> : <%= eachData.title %>
                    </h4>
                </div>

                <div class="card offset-6 listing-card" style="width: 20rem;">
                    <img src=<%=eachData.image.url %> class="card-img-top " alt="listing_image">
                    <div class="card-body">
                        <p class="card-text">
                            <i>Owner :<%=eachData.owner.username%></i>
                        </p>
                        <h4><span>
                                <%= eachData.description%>
                            </span></h4>
                        <p><span>
                                &#8377; <%= eachData.price%>
                            </span></p>
                        <p><span>
                                <%= eachData.country%>
                            </span></p>
                    </div>
                </div>
                <%if(curUser &&curUser._id.equals(eachData.owner._id)){%>
                    <div class="btns mb-2 offset-6">
                        <a href="/listings/<%= eachData._id %>/edit" class="btn btn-dark ">edit</a>
                        <form action="/listings/<%= eachData._id %>/?_method=DELETE" method="post">
                            <button class="btn add-btn offset-3">delete</button>
                        </form>
                    </div>
                    <%}%>
                        <!-- reviews -->

                        <div class="mb-3 col-8 offset-6">
                            <hr>
                            <%if(curUser){%>

                                <h4>Leave a Review</h4>
                                <form action="/listings/<%=eachData._id %>/reviews" method="post" novalidate
                                    class="needs-validation">

                                    <div class="mb-3">
                                        <label for="rating" class="form-label">Rating</label>
                                        <fieldset class="starability-slot">

                                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                                                value="1" checked aria-label="No rating." />
                                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                            <label for="first-rate1" title="Terrible">1 star</label>
                                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                            <label for="first-rate2" title="Not good">2 stars</label>
                                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                            <label for="first-rate3" title="Average">3 stars</label>
                                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                            <label for="first-rate4" title="Very good">4 stars</label>
                                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                            <label for="first-rate5" title="Amazing">5 stars</label>
                                        </fieldset>
                                    </div>
                                    <div class="mb-3">
                                        <label for="comment" class="form-label">Comments</label>
                                        <textarea name="review[comment]" id="comment" class="form-control" rows="5"
                                            cols="5" placeholder="give review!" required></textarea>
                                        <div class="invalid-feedback">
                                            please enter the review!
                                        </div>
                                    </div>
                                    <button class="btn-dark">Submit</button>
                                </form>
                                <hr>
                                <%}%>

                                    <p><b>All Reviews</b></p>
                                    <%if (eachData.reviews.length!=0){%>
                                        <div class="row">
                                            <%for (let review of eachData.reviews){%>
                                                <div class="card mb-2 col-5 ms-2">
                                                    <div class="card-body">
                                                        <div class="card-title"><i>author:<%=review.author.username%>
                                                            </i></div>
                                                        <p class="starability-result card-text"
                                                            data-rating="<%= review.rating%>"> </p>
                                                        <div class="card-text">comment:<%= review.comment%> </div><br>

                                                        <form
                                                            action="/listings/<%=eachData._id%>/reviews/<%=review._id%>/?_method=delete"
                                                            method="post">
                                                            <button class="btn btn-sm btn-dark">Delete</button>
                                                        </form>
                                                        <br>
                                                    </div>
                                                </div>
                                                <%}%>
                                        </div>
                                        <%} else{%>
                                            <p>No reviews till now !</p>
                                            <% } %>
                        </div>
            </div>
        </div>
        </div>
    </body>
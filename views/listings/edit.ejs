<% layout("/layouts/boilerplate") %>
    <h1>Edit Listing</h1>
    <div class="row">
        <div class="col-8 offset-2">
            <br><br>
            <form action="/listings/<%= eachData._id %>/?_method=PUT" method="post" class="needs-validation" novalidate
                enctype="multipart/form-data">

                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" name="listing[title]" id="title" class=" form-control" value=<%=eachData.title%>
                    required>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">description</label>
                    <textarea name="listing[description]" id="description" class=" form-control"
                        required><%=eachData.description%></textarea>
                </div>

                <div class="mb-3">
                    Original Image <br>
                    <img src="<%=eachData.image.url%>" alt="no image" width="150px" height="150" >
                </div>

                <div class="mb-3">
                    <input type="file" name="listing[image]" id="image" class=" form-control" required>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="price" class="form-label">price</label>
                        <input name="listing[price]" id="price" value=<%=eachData.price%> class="
                        form-control" required>
                    </div>

                    <div class="col-md-8 mb-3">
                        <label for="country" class="form-label">country</label>
                        <input type="text" name="listing[country]" id="country" value=<%=eachData.country%> class="
                        form-control" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">location</label>
                    <input type="text" name="listing[location]" id="location" value=<%=eachData.location%> class="
                    form-control" required>
                </div>

                <button class="btn btn-dark">Submit</button>
            </form>
        </div>
    </div>
    </body>